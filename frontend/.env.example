# Optional. Telemetry remains fully local when this value is unset.
# Production builds require HTTPS. Localhost HTTP is accepted only in Vite development mode.
VITE_TELEMETRY_ENDPOINT=https://laogao.xyz/geod-telemetry/v1/events

# Optional for validation builds: suppress automatic update checks, first-run
# analytics consent, onboarding, and analytics transport without changing consent.
# Vite dev and --mode validation already apply this behavior automatically.
VITE_GEOD_VALIDATION=0
