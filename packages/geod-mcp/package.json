{
  "name": "geod-mcp",
  "version": "0.1.2",
  "description": "GeoD CLI imagery download tools for local and remote MCP clients",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gaopengbin/geo-downloader.git",
    "directory": "packages/geod-mcp"
  },
  "homepage": "https://github.com/gaopengbin/geo-downloader",
  "bugs": "https://github.com/gaopengbin/geo-downloader/issues",
  "keywords": [
    "geod",
    "mcp",
    "agent",
    "gis",
    "geotiff",
    "geojson"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "os": [
    "win32"
  ],
  "cpu": [
    "x64"
  ],
  "files": [
    "bin/",
    "src/",
    "scripts/",
    "examples/",
    "skill/",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "geod-mcp": "bin/geod-mcp.mjs"
  },
  "scripts": {
